# Votación persistente (opcional). Crealas en Vercel → Storage → Upstash Redis.
# Sin estas variables la votación funciona en modo demostración (solo en el navegador).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Sal para anonimizar IPs al evitar votos duplicados. Cualquier texto largo y secreto.
VOTE_SALT=
